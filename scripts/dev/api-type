#!/usr/bin/env python3
"""Print one schema or one API path from the generated frontend types (KAN-618).

    scripts/dev/api-type CustomerRead        a schema (components["schemas"]), exact name
    scripts/dev/api-type /v1/customers       a path and the operations it names
    scripts/dev/api-type /v1/customers/{customer_id}

`frontend/apps/dms/src/api/schema.d.ts` is ~800 KB (about 200,000 tokens), generated by
`make generate-frontend-types` and never read whole (the Read and pre-bash hooks refuse it). This
prints just the block asked for, at most 200 lines, and says so when nothing matches -
naming the closest names. Standard library only.
"""

import os
import re
import signal
import subprocess
import sys

MAX_LINES = 200
SCHEMA = os.path.join("frontend", "apps", "dms", "src", "api", "schema.d.ts")


def root():
    return subprocess.run(["git", "rev-parse", "--show-toplevel"], stdout=subprocess.PIPE,
                          universal_newlines=True, check=True).stdout.strip()


def block(lines, start):
    """Lines from `start` (a line ending in `{`) to the line closing it, comments above included."""
    first = start
    while first > 0 and lines[first - 1].strip().startswith(("/**", "*", "*/")):
        first -= 1
    depth, end = 0, start
    for end in range(start, len(lines)):
        depth += lines[end].count("{") - lines[end].count("}")
        if depth <= 0:
            break
    return lines[first:end + 1]


def section(lines, header):
    """(first, last) line index of a top-level `export interface <header> {` block."""
    for i, line in enumerate(lines):
        if line.startswith("export interface {} {{".format(header)):
            return i, i + len(block(lines, i)) - 1
    return None


def entries(lines, span, indent):
    """name -> line index of each member at exactly `indent` spaces inside span."""
    found = {}
    pattern = re.compile(r'^ {%d}(?:"([^"]+)"|([A-Za-z_$][\w$]*))\??: \{$' % indent)
    for i in range(span[0] + 1, span[1]):
        m = pattern.match(lines[i])
        if m:
            found[m.group(1) or m.group(2)] = i
    return found


def emit(chunks):
    out = [line for chunk in chunks for line in chunk]
    for line in out[:MAX_LINES]:
        print(line)
    if len(out) > MAX_LINES:
        print("... {} more lines cut at {} - ask for a referenced schema by name.".format(len(out) - MAX_LINES,
                                                                                         MAX_LINES))


def closest(query, names):
    q = query.lower().strip("/")
    hits = [n for n in names if q in n.lower()]
    return sorted(hits, key=len)[:15]


def main(argv):
    if len(argv) != 1 or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if argv and argv[0] in ("-h", "--help") else 2
    query = argv[0]
    path = os.path.join(root(), SCHEMA)
    with open(path, encoding="utf-8") as f:
        lines = f.read().split("\n")
    if query.startswith("/"):
        paths = entries(lines, section(lines, "paths"), 4)
        ops = entries(lines, section(lines, "operations"), 4)
        if query not in paths:
            print("No path {} in {}.".format(query, SCHEMA))
            near = closest(query, paths)
            if near:
                print("Paths containing it: " + ", ".join(near))
            return 1
        chunk = block(lines, paths[query])
        named = re.findall(r'operations\["([^"]+)"\]', "\n".join(chunk))
        emit([chunk] + [[""] + block(lines, ops[op]) for op in named if op in ops])
        return 0
    comps = section(lines, "components")
    schemas = entries(lines, comps, 8)
    if query not in schemas:
        print("No schema {} in {}.".format(query, SCHEMA))
        near = closest(query, schemas)
        if near:
            print("Schemas containing it: " + ", ".join(near))
        return 1
    emit([block(lines, schemas[query])])
    return 0


if __name__ == "__main__":
    signal.signal(signal.SIGPIPE, signal.SIG_DFL)  # `| head` ends the output quietly
    sys.exit(main(sys.argv[1:]))
