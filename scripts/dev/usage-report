def _word(name):
    """`name` as a whole word of a command (a program or an argument), with any directory in
    front (.venv/bin/pytest) - never a part of a longer word or path (/tmp/pytest-of-anto/)."""
    return r"(?:^|(?<=[\s;&|(`]))(?:[^\s;&|(`]*/)?" + name + r"(?=[\s;&|)`]|$)"  # linear: ( and ` end a prefix


CI_BASH = re.compile(_word("gh") + r"\s+(pr\s+checks|run\s+(watch|view|list)|api\b[^\n]*(check-runs|check-suites|actions/runs|/status\b))")
CI_WORDS = re.compile(r"check-runs|check-suites|gh\s+pr\s+checks|gh\s+run\b|\bCI\b")
