        sid = write_fixture(folder)
        session = Session(sid, [os.path.join(folder, sid + ".jsonl")],
                          glob.glob(os.path.join(folder, sid, "subagents", "*.jsonl")), Paths("/x"))
        main = session.main
        got = {k: main.totals()[k] for k in ("calls", "input_side", "output")}
        if got != {"calls": 5, "input_side": 6650, "output": 100}:
            failures.append(f"main totals {got}")
        if sum(main.carried.values()) != main.totals()["input_side"]:
            failures.append(f"shares do not add up to the input side: {dict(main.carried)}")
        # nothing to calibrate on (no one-item step of 500+ characters): 2.25 characters per token
        expected = {"start": 3152, "instructions": 708, "prompts": 228, "model": 220, "read": 1200,
                    "rules": 600, "ci": 40, "notion": 90, "carryover": 412}
        if dict(main.carried) != expected:
            failures.append(f"carried {dict(main.carried)} != {expected}")
        if (main.ci_steps, main.ci_step_tokens) != (1, 1710):
            failures.append(f"CI steps {(main.ci_steps, main.ci_step_tokens)}")
        if [(s.agent, s.totals()["total"]) for s in session.subs] != [("reviewer", 320)]:
            failures.append(f"sub-agents {[(s.agent, s.totals()) for s in session.subs]}")
        if session.tickets != ["KAN-1"]:
            failures.append(f"tickets {session.tickets}")
        h = headline(session, 300)
        if (h["total"], h["reviewer"], h["rules"], h["reads"], h["notion"], h["ci"]) != (7070, 320, 1308, 1200, 90, 1710):
            failures.append(f"headline {h}")
        # a step's growth beyond what its items can hold goes to ToolSearch, else to no recorded source
        read = {"cat": "read", "chars": 1400, "images": 0}
        loader = {"cat": "toolsearch", "chars": 100, "images": 0}
        # (beside a ToolSearch an item holds 1,400 / 2.25 = 622 tokens; alone, 1,400 / 1.4 = 1,000)
        if split_growth(5000, [read, loader]) != ([622, 4378], 0) or split_growth(5000, [read]) != ([1000], 4000):
            failures.append(f"split_growth {split_growth(5000, [read, loader])} {split_growth(5000, [read])}")
        if split_growth(700, [read, dict(read)]) != ([350, 350], 0):
            failures.append(f"split_growth proportional {split_growth(700, [read, dict(read)])}")
        empty = {"cat": "toolsearch", "chars": 0, "images": 0}
        if split_growth(900, [empty, empty, dict(loader, chars=1)]) != ([300, 300, 300], 0):
            failures.append(f"split_growth empty loaders {split_growth(900, [empty, empty, dict(loader, chars=1)])}")
        # no word of a command's text ever becomes a label
        for command in ("sed -n 's/" + MARKER + "=x/y/p' app/x.py", "cat <<EOF\n" + MARKER + ".AG\nEOF",
                        "cd /x\ngit commit -m \"Fix it; " + MARKER + " asked\"",
                        "cd /x\npython3 - <<'EOF'\nx = 1; " + MARKER + " = 2\nEOF",
                        "cd /x\ncat <<'EOF' > notes.txt\nhello; cat " + MARKER + ".AG\nEOF",
                        "less +/" + MARKER + " app/x.py", "sed -n -e 'y/" + MARKER + "/b/' app/x.py",
                        MARKER + " --flag", "cd /x\n" + MARKER + ".sh"):
            _cat, label = classify_tool("Bash", {"command": command}, Paths("/x"))
            if MARKER in label:
                failures.append("a Bash label printed command text: " + repr(command[:30]))
        buffer = io.StringIO()
        saved = socket.socket.connect, socket.create_connection
        socket.socket.connect, socket.create_connection = refuse, refuse
        try:
            code = run(["--project-dir", folder, "--repo", "/x", "--large-read-tokens", "300"], buffer)
        finally:
            socket.socket.connect, socket.create_connection = saved
        text = buffer.getvalue()
        if code != 0:
            failures.append(f"exit code {code}")
        if MARKER in text:
            failures.append("transcript content printed")
        for needle in ("Read app/x.py", "notion-fetch " + "a" * 32, "Bash (CI poll)", "reviewer (1)",
                       "| 7,070 * | 95.5% | 4.5% | 4.5% | 18.5% | 17.0% | 1.3% | 24.2% |",
                       "* Some calls recorded only a streaming snapshot"):
            if needle not in text:
                failures.append("missing from the report: " + needle)
    for failure in failures:
        print("FAIL " + failure, file=out)
    print("selftest: " + ("ok" if not failures else f"{len(failures)} failure(s)"), file=out)
    return 1 if failures else 0


if __name__ == "__main__":
    with contextlib.suppress(BrokenPipeError):
        sys.exit(run(sys.argv[1:], sys.stdout))
