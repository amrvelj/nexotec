MARKER = "SECRET-TRANSCRIPT-TEXT"


def write_fixture(folder):
    """One session with known numbers; every content field carries MARKER. Returns its id."""
    sid = "11111111-2222-3333-4444-555555555555"
    filler = (MARKER + " ") * 200

    def asst(mid, usage, blocks):
        return {"type": "assistant", "timestamp": "2026-11-01T10:00:00Z", "gitBranch": "kan-1-x",
                "message": {"id": mid, "model": "m", "usage": usage, "content": blocks}}

    def use(i, r, w, o):
        return {"input_tokens": i, "cache_read_input_tokens": r, "cache_creation_input_tokens": w,
                "output_tokens": o}

    def result(tid, chars):
        return {"type": "user", "message": {"content": [
            {"type": "tool_result", "tool_use_id": tid, "content": filler[:chars]}]}}

    lines = [
        {"type": "attachment", "timestamp": "2026-11-01T10:00:00Z", "attachment": {"type": "instructions"},
         "rendered": [{"type": "text", "text": filler[:400]}]},
        {"type": "user", "timestamp": "2026-11-01T10:00:00Z", "message": {"content":
            "<command-name>/ticket</command-name>\n<command-args>KAN-1</command-args>" + filler[:9]}},
        # one call written as two records (thinking, then the tool call): counted once
        asst("m1", use(10, 0, 990, 50), [{"type": "thinking", "thinking": MARKER}]),
        asst("m1", use(10, 0, 990, 50), [{"type": "tool_use", "id": "t1", "name": "Read",
                                          "input": {"file_path": "/x/.claude/worktrees/wt/app/x.py"}}]),
        result("t1", 2000),
        {"type": "attachment", "attachment": {"type": "nested_memory", "path": "/x/.claude/rules/tests.md"},
         "rendered": [{"type": "text", "text": filler[:1000]}]},
        asst("m2", use(5, 1000, 645, 30), [{"type": "tool_use", "id": "t2", "name": "Bash",
                                            "input": {"command": "gh pr checks 5 # " + MARKER}}]),
        result("t2", 100),
        asst("m3", use(5, 1645, 50, 10), [{"type": "tool_use", "id": "t3", "name": "mcp__abc__notion-fetch",
                                           "input": {"id": "https://app.notion.com/p/" + "a" * 32}}]),
        result("t3", 400),
        asst("m4", use(5, 1695, 100, 5), [{"type": "text", "text": MARKER}]),
        {"type": "system", "subtype": "compact_boundary"},
        {"type": "user", "message": {"content": filler[:200]}},
        asst("m5", use(500, 0, 0, 5), [{"type": "text", "text": MARKER}]),
    ]
    os.makedirs(os.path.join(folder, sid, "subagents"))
    with open(os.path.join(folder, sid + ".jsonl"), "w") as handle:
        handle.write("\n".join(json.dumps(x) for x in lines) + "\n")
    sub = os.path.join(folder, sid, "subagents", "agent-a1.jsonl")
    with open(sub, "w") as handle:
        handle.write(json.dumps({"type": "user", "isSidechain": True, "message": {"content": filler[:40]}}) + "\n")
        handle.write(json.dumps(asst("r1", use(5, 0, 295, 20), [{"type": "text", "text": MARKER}])) + "\n")
    with open(sub[: -len(".jsonl")] + ".meta.json", "w") as handle:
        json.dump({"agentType": "reviewer", "description": MARKER}, handle)
    return sid


def selftest(out):
    import socket

    def refuse(*_args, **_kwargs):
        raise AssertionError("usage-report opened a network connection")

    failures = []
    with tempfile.TemporaryDirectory() as folder:
        sid = write_fixture(folder)
        session = Session(sid, [os.path.join(folder, sid + ".jsonl")],
                          glob.glob(os.path.join(folder, sid, "subagents", "*.jsonl")), Paths("/x"))
        main = session.main
        got = {k: main.totals()[k] for k in ("calls", "input_side", "output")}
        if got != {"calls": 5, "input_side": 6650, "output": 100}:
            failures.append("main totals {}".format(got))
        if sum(main.carried.values()) != main.totals()["input_side"]:
            failures.append("shares do not add up to the input side: {}".format(dict(main.carried)))
        expected = {"start": 3520, "instructions": 400, "prompts": 130, "model": 220, "read": 1200,
                    "rules": 600, "ci": 40, "notion": 90, "carryover": 450}
        if dict(main.carried) != expected:
            failures.append("carried {} != {}".format(dict(main.carried), expected))
        if (main.ci_steps, main.ci_step_tokens) != (1, 1710):
            failures.append("CI steps {}".format((main.ci_steps, main.ci_step_tokens)))
        if [(s.agent, s.totals()["total"]) for s in session.subs] != [("reviewer", 320)]:
            failures.append("sub-agents {}".format([(s.agent, s.totals()) for s in session.subs]))
        if session.tickets != ["KAN-1"]:
            failures.append("tickets {}".format(session.tickets))
        h = headline(session, 300)
        if (h["total"], h["reviewer"], h["rules"], h["reads"], h["notion"], h["ci"]) != (7070, 320, 1000, 1200, 90, 1710):
            failures.append("headline {}".format(h))
        buffer = io.StringIO()
        saved = socket.socket.connect, socket.create_connection
        socket.socket.connect, socket.create_connection = refuse, refuse
        try:
            code = run(["--project-dir", folder, "--repo", "/x", "--large-read-tokens", "300"], buffer)
        finally:
            socket.socket.connect, socket.create_connection = saved
        text = buffer.getvalue()
        if code != 0:
            failures.append("exit code {}".format(code))
        if MARKER in text:
            failures.append("transcript content printed")
        for needle in ("Read app/x.py", "notion-fetch " + "a" * 32, "Bash (CI poll)", "reviewer (1)",
                       "| 7,070 | 95.5% | 4.5% | 4.5% | 14.1% | 17.0% | 1.3% | 24.2% |"):
            if needle not in text:
                failures.append("missing from the report: " + needle)
    for failure in failures:
        print("FAIL " + failure, file=out)
    print("selftest: " + ("ok" if not failures else "{} failure(s)".format(len(failures))), file=out)
    return 1 if failures else 0


if __name__ == "__main__":
    with contextlib.suppress(BrokenPipeError):
        sys.exit(run(sys.argv[1:], sys.stdout))
