             ("vitest", _word("vitest")), ("npm lint/build/test", _word("npm") + r"[^\n;&|]*\b(lint|build|test)\b"),
             ("mypy", _word("mypy")), ("ruff", _word("ruff")), ("lint-imports", _word("lint-imports")),
             ("tsc", _word("tsc")), ("alembic", _word("alembic"))]
