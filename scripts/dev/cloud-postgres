#!/usr/bin/env bash
# Cloud sessions only: start this machine's own Postgres 16 and make sure the project's
# database user exists, so bootstrap, check and pytest find on localhost:5432 what Docker
# Desktop's `db` service gives them on a Mac: user `dms`, password `dms`, a superuser like
# the one the postgres image creates. Called by scripts/dev/bootstrap and scripts/dev/check;
# safe to run again.
#
# Why: a cloud session's machine has PostgreSQL 16 installed but not running, and no Docker
# daemon. A paused cloud machine can come back without it, so check runs this every time.
set -euo pipefail

if [ "${CLAUDE_CODE_REMOTE:-}" != "true" ]; then
  echo "scripts/dev/cloud-postgres is for cloud sessions. On your Mac, Docker Desktop provides Postgres."
  exit 2
fi

pg_up() { (exec 3<>/dev/tcp/localhost/5432) 2>/dev/null; }

if ! pg_up; then
  service postgresql start >/dev/null 2>&1 || pg_ctlcluster 16 main start
  for _ in $(seq 1 30); do pg_up && break; sleep 1; done
fi
if ! pg_up; then
  echo "Could not start this machine's Postgres on localhost:5432 (service postgresql start failed)."
  exit 1
fi

# The postgres image makes POSTGRES_USER a superuser; mirror it, so migrations and tests
# see the same rights here as on the Mac and in CI.
su postgres -c "psql -q -X -v ON_ERROR_STOP=1 -d postgres" <<'SQL'
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = 'dms') THEN
    CREATE ROLE dms LOGIN SUPERUSER PASSWORD 'dms';
  ELSE
    ALTER ROLE dms LOGIN SUPERUSER PASSWORD 'dms';
  END IF;
END
$$;
SQL
echo "ok: this machine's Postgres runs on localhost:5432 with the project's dms user"
