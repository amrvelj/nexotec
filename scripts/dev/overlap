#!/usr/bin/env python3
"""Which open pull requests touch the files this branch changes (KAN-684).

    scripts/dev/overlap                    the files this branch changes against origin/main
    scripts/dev/overlap <path|glob> ...    the files a plan names, before anything is changed
    scripts/dev/overlap --json             the same, for callers
    scripts/dev/overlap --selftest         checks itself against recorded API answers (no network)

For each file it names every open PR that changes it too, with that PR's ticket and head; for each
Alembic chain this branch adds a revision to (one chain per context, ADR-015), every open PR that adds
one to the same chain - the second of the two to merge makes a second head. Two tickets may overlap;
this says so before they meet at the merge. It never blocks, locks or claims anything, and always
exits 0.

GitHub's REST API only (`gh api`, explicit `page=`): cloud sessions refuse GraphQL (KAN-155) and the
numeric `repositories/<id>` links `--paginate` follows. Only file names are read from another PR -
its diff (`patch`) is dropped unread and never printed. Standard library only, like the hooks.
"""

import contextlib
import fnmatch
import io
import json
import os
import re
import subprocess
import sys

MIGRATIONS = "alembic/versions/"
TICKET = re.compile(r"\bKAN-(\d+)\b", re.IGNORECASE)
BRANCH_TICKET = re.compile(r"^kan-(\d+)\b", re.IGNORECASE)
PER_PAGE = 100
MAX_PAGES = 30  # GitHub lists at most 3000 files of a PR


def run(cmd, cwd, timeout=60):
    try:
        proc = subprocess.run(cmd, cwd=cwd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                              universal_newlines=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 127, "", exc.__class__.__name__
    return proc.returncode, proc.stdout, proc.stderr


def gh_fetch(root):
    """A fetch(path) -> (data, problem) over `gh api` from `root` ({owner}/{repo} from its remote)."""
    def fetch(path):
        rc, out, err = run(["gh", "api", path], root)
        if rc != 0:
            detail = (err or out or "").strip().splitlines()
            return None, "GitHub refused `gh api {}`: {}".format(path.split("?")[0], detail[0] if detail else rc)
        try:
            return json.loads(out or "null"), None
        except ValueError:
            return None, "could not read the answer to `gh api {}`".format(path.split("?")[0])
    return fetch


def pages(fetch, path):
    """Every item of a REST list, page by page; (items, problem). Never a silently shortened list."""
    items = []
    for page in range(1, MAX_PAGES + 1):
        data, problem = fetch("{}{}per_page={}&page={}".format(path, "&" if "?" in path else "?", PER_PAGE, page))
        if problem:
            return None, problem
        batch = data if isinstance(data, list) else []
        items.extend(batch)
        if len(batch) < PER_PAGE:
            return items, None
    return None, "`{}` lists more than {} entries - not read further".format(path.split("?")[0], PER_PAGE * MAX_PAGES)


def chain_of(path):
    """The Alembic chain a migration file belongs to: its context folder, `legacy` for the top folder."""
    if not (path.startswith(MIGRATIONS) and path.endswith(".py")):
        return None
    rest = path[len(MIGRATIONS):].split("/")
    return rest[0] if len(rest) == 2 else "legacy" if len(rest) == 1 else None


def branch_changes(root):
    """(status, path) for what this branch changes against origin/main: commits and the working copy."""
    changes = {}
    rc, out, _ = run(["git", "diff", "--name-status", "--no-renames", "origin/main...HEAD"], root)
    for line in out.splitlines() if rc == 0 else []:
        status, _, path = line.partition("\t")
        changes[path] = status[:1]
    rc, out, _ = run(["git", "status", "--porcelain", "--untracked-files=all", "--no-renames"], root)
    for line in out.splitlines() if rc == 0 else []:
        status, path = line[:2], line[3:]
        changes.setdefault(path, "A" if status in ("??", "A ") else "M")
    return sorted(changes.items(), key=lambda item: item[1])


def pull_label(pull):
    """What names another PR: number, ticket(s), branch and head."""
    head = pull.get("head") or {}
    tickets = ["KAN-" + n for n in dict.fromkeys(TICKET.findall(pull.get("title") or ""))]
    if not tickets:
        m = BRANCH_TICKET.match(head.get("ref") or "")
        tickets = ["KAN-" + m.group(1)] if m else []
    return {"number": pull.get("number"), "tickets": tickets, "branch": head.get("ref"),
            "head": (head.get("sha") or "")[:10], "url": pull.get("html_url"), "draft": bool(pull.get("draft"))}


def overlap(changes, patterns, branch, fetch):
    """The report as a dict. `changes`: [(status, path)] of this branch; `patterns`: paths or globs a plan
    names (used instead of `changes` when given)."""
    mine = list(patterns) if patterns else [path for _status, path in changes]
    chains = sorted({c for c in (chain_of(p.replace("*", "x.py") if p.endswith("/*") else p) for p in patterns)
                     if c} if patterns else {chain_of(p) for s, p in changes if s == "A" and chain_of(p)})
    report = {"compared": mine, "chains_added": chains, "files": {}, "chains": {}, "open_prs": 0, "problem": None}
    if not mine:
        return report
    pulls, problem = pages(fetch, "repos/{owner}/{repo}/pulls?state=open")
    if problem:
        report["problem"] = problem
        return report
    others = [p for p in pulls if (p.get("head") or {}).get("ref") != branch]
    report["open_prs"] = len(others)
    for pull in sorted(others, key=lambda p: p.get("number") or 0):
        files, problem = pages(fetch, "repos/{{owner}}/{{repo}}/pulls/{}/files".format(pull.get("number")))
        if problem:
            report["problem"] = problem
            return report
        # names only: `patch` (the diff) is never kept
        touched = [(f.get("status"), f.get("filename")) for f in files if f.get("filename")]
        touched += [("renamed", f["previous_filename"]) for f in files if f.get("previous_filename")]
        label = pull_label(pull)
        for wanted in mine:
            if any(name == wanted or fnmatch.fnmatchcase(name, wanted) for _s, name in touched):
                report["files"].setdefault(wanted, []).append(label)
        for chain in chains:
            if any(status == "added" and chain_of(name) == chain for status, name in touched):
                report["chains"].setdefault(chain, []).append(label)
    return report


def describe(label):
    return "PR #{} {}({}, head {}){}".format(label["number"], " ".join(label["tickets"]) + " " if label["tickets"] else "",
                                             label["branch"], label["head"], " draft" if label["draft"] else "")


def render(report):
    lines = []
    if report["problem"]:
        return "Overlaps: unknown - {}. Nothing is blocked; say so in the plan.".format(report["problem"])
    if not report["compared"]:
        return ("Overlaps: nothing to compare - this branch changes nothing against origin/main yet. "
                "Name the plan's files: scripts/dev/overlap <path|glob> ...")
    if not report["files"] and not report["chains"]:
        return "Overlaps: none ({} file(s) or pattern(s) against {} open PR(s)).".format(
            len(report["compared"]), report["open_prs"])
    lines.append("Overlaps ({} file(s) or pattern(s) against {} open PR(s)):".format(
        len(report["compared"]), report["open_prs"]))
    for path in sorted(report["files"]):
        lines.append("  {}".format(path))
        lines += ["      also {}".format(describe(label)) for label in report["files"][path]]
    for chain in sorted(report["chains"]):
        for label in report["chains"][chain]:
            lines.append("  migration chain `{}`: {} adds a revision too - the second to merge makes a second head. "
                         "Land after PR #{} and re-parent this revision onto its head.".format(
                             chain, describe(label), label["number"]))
    return "\n".join(lines)


def main(argv, fetch=None, root=None):
    as_json = "--json" in argv
    patterns = [a for a in argv if not a.startswith("--")]
    root = root or run(["git", "rev-parse", "--show-toplevel"], os.getcwd())[1].strip() or os.getcwd()
    rc, branch, _ = run(["git", "symbolic-ref", "--quiet", "--short", "HEAD"], root)
    report = overlap([] if patterns else branch_changes(root), patterns, branch.strip() if rc == 0 else None,
                     fetch or gh_fetch(root))
    print(json.dumps(report, indent=1, sort_keys=True) if as_json else render(report))
    return 0


def selftest():
    """Recorded API answers (shapes as `gh api` returned them on 2026-11-13); no network."""
    def pull(number, ref, title, sha="0123456789abcdef", draft=False):
        return {"number": number, "title": title, "draft": draft, "html_url": "https://github.com/o/r/pull/%d" % number,
                "head": {"ref": ref, "sha": sha}}
    secret = "DIFF-CONTENT-NEVER-PRINTED"
    recorded = {
        "repos/{owner}/{repo}/pulls?state=open&per_page=100&page=1": [
            pull(330, "kan-700-locales", "KAN-700: stock captions in four languages"),
            pull(331, "kan-701-vehicle-mig", "Vehicle: add a plate column", draft=True),
            pull(332, "mine", "KAN-684: this branch"),
            pull(333, "kan-702-other", "KAN-702: nothing in common")],
        "repos/{owner}/{repo}/pulls/330/files?per_page=100&page=1": [
            {"filename": "frontend/apps/dms/src/i18n/locales/de.json", "status": "modified", "patch": secret},
            {"filename": ".claude/rules/ui.md", "status": "renamed", "previous_filename": ".claude/rules/old-ui.md"}],
        "repos/{owner}/{repo}/pulls/331/files?per_page=100&page=1": [
            {"filename": "alembic/versions/vehicle/9a_add_plate.py", "status": "added", "patch": secret},
            {"filename": "alembic/versions/customer/1b_touch.py", "status": "modified", "patch": secret}],
        "repos/{owner}/{repo}/pulls/332/files?per_page=100&page=1": [
            {"filename": "frontend/apps/dms/src/i18n/locales/de.json", "status": "modified"}],
        "repos/{owner}/{repo}/pulls/333/files?per_page=100&page=1": [{"filename": "app/sales/x.py", "status": "modified"}],
    }
    calls = []

    def fetch(path):
        calls.append(path)
        return (recorded[path], None) if path in recorded else ([], None)
    changes = [("M", "frontend/apps/dms/src/i18n/locales/de.json"), ("A", "alembic/versions/vehicle/7c_mine.py"),
               ("M", ".claude/rules/old-ui.md"), ("A", "alembic/versions/customer/2c_new.py"), ("M", "README.md")]
    report = overlap(changes, [], "mine", fetch)
    assert all(not c.startswith("repos/{owner}/{repo}/pulls/332/") for c in calls), "read its own PR"
    assert [p["number"] for p in report["files"]["frontend/apps/dms/src/i18n/locales/de.json"]] == [330], report
    assert report["files"]["frontend/apps/dms/src/i18n/locales/de.json"][0]["tickets"] == ["KAN-700"]
    assert [p["number"] for p in report["files"][".claude/rules/old-ui.md"]] == [330], "a rename's old name was missed"
    assert list(report["chains"]) == ["vehicle"], report["chains"]  # customer: 331 only modifies there
    assert report["chains"]["vehicle"][0]["tickets"] == ["KAN-701"]  # from the branch name: the title has none
    assert "README.md" not in report["files"] and report["open_prs"] == 3
    text = render(report)
    assert secret not in text and secret not in json.dumps(report), "another PR's diff reached the output"
    assert "PR #330 KAN-700 (kan-700-locales, head 0123456789)" in text, text
    assert "second head" in text and "Land after PR #331 and re-parent" in text, text
    # a plan's paths and globs, before anything changed
    planned = overlap([], ["frontend/apps/dms/src/i18n/locales/*.json", "alembic/versions/vehicle/*"], "mine", fetch)
    assert sorted(planned["files"]) == ["alembic/versions/vehicle/*", "frontend/apps/dms/src/i18n/locales/*.json"]
    assert planned["chains_added"] == ["vehicle"], planned
    assert [p["number"] for p in planned["chains"]["vehicle"]] == [331]
    assert render(overlap([("M", "app/nothing.py")], [], "mine", fetch)).startswith("Overlaps: none (1 file(s)")
    assert render(overlap([], [], "mine", fetch)).startswith("Overlaps: nothing to compare")
    # GitHub refusing: said, never an exit code
    refused = overlap(changes, [], "mine", lambda path: (None, "GitHub refused `gh api x`: HTTP 403"))
    assert render(refused).startswith("Overlaps: unknown - GitHub refused") and refused["files"] == {}
    # paging: a full page asks for the next one
    many = {"repos/{owner}/{repo}/pulls?state=open&per_page=100&page=1": [pull(n, "b%d" % n, "x") for n in range(100)],
            "repos/{owner}/{repo}/pulls?state=open&per_page=100&page=2": [pull(500, "kan-500-z", "KAN-500")]}
    items, problem = pages(lambda p: (many.get(p, []), None), "repos/{owner}/{repo}/pulls?state=open")
    assert problem is None and len(items) == 101
    assert chain_of("alembic/versions/a1_x.py") == "legacy" and chain_of("alembic/versions/sales/b2.py") == "sales"
    assert chain_of("alembic/env.py") is None and chain_of("app/x.py") is None
    with contextlib.redirect_stdout(io.StringIO()) as out:
        assert main(["--json"], fetch=fetch) == 0  # against this checkout, recorded answers: never non-zero
    assert json.loads(out.getvalue())["problem"] is None
    print("overlap selftest: ok")
    return 0


if __name__ == "__main__":
    if "--selftest" in sys.argv[1:]:
        sys.exit(selftest())
    sys.exit(main(sys.argv[1:]))
