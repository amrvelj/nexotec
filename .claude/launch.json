{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nexotec-api",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": [
        "app.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "port": 8000,
      "autoPort": false,
      "env": {
        "DYLD_FALLBACK_LIBRARY_PATH": "/opt/homebrew/lib:/usr/local/lib:/usr/lib"
      }
    },
    {
      "name": "nexotec-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend/apps/dms",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173,
      "autoPort": false
    },
    {
      "name": "nexotec-prototype",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8123",
        "--directory",
        "/Users/antomrvelj/Library/CloudStorage/GoogleDrive-mrvelj.anto@gmail.com/Meine Ablage/1. Persönlich/11. Arbeit/Anto/Nexotec/dms-platform/ui-prototype"
      ],
      "port": 8123,
      "autoPort": false
    }
  ]
}
