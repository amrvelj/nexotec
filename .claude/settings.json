  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/nexotec_hooks.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\" session-start",
            "timeout": 30,
            "statusMessage": "Checking the Nexotec workspace"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/nexotec_hooks.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\" session-sync",
            "timeout": 120,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/nexotec_hooks.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\" pre-bash",
            "timeout": 120
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/nexotec_hooks.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\" pre-edit",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/nexotec_hooks.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\" pre-read",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*[Nn]otion.*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/nexotec_hooks.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\" pre-notion",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "mcp__.*[Rr]ender.*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/nexotec_hooks.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\" pre-render",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/nexotec_hooks.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\" post-tool",
            "timeout": 120
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "reviewer",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/nexotec_hooks.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\" subagent-stop",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/nexotec_hooks.py\"; [ -f \"$f\" ] || exit 0; exec python3 \"$f\" stop",
            "timeout": 120,
            "statusMessage": "Checking the hand-over gate"
          }
        ]
      }
    ]
  }
}
