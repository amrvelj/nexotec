DMS_DATABASE_URL=postgresql+psycopg://dms:dms@localhost:5432/dms_platform

# Required, no built-in default or fallback (app fails to start without it).
# Generate your own locally, one per environment — never reuse the same key
# across dev/staging/prod, and never commit a real value here:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DMS_TAX_ID_ENCRYPTION_KEY=

# Required, no built-in default (ADR-007, WP-2 PR-1) — RS256, not the old
# shared HS256 secret. Generate your own locally, one per environment:
#   python -c "
#   from cryptography.hazmat.primitives import serialization
#   from cryptography.hazmat.primitives.asymmetric import rsa
#   key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
#   print(key.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()).decode())"
# A real .env file (not this .example) can hold the PEM's actual newlines
# directly. `make up` generates one for you on first run — see the README's
# "Running the whole stack" section.
DMS_JWT_PRIVATE_KEY=

# Required, no built-in default (WP-4, ADR-016) — Zitadel (CH region) is the
# external OIDC provider; it authenticates, it never assigns roles. You need
# a real Zitadel org + application registration (issuer URL, client ID,
# client secret) and the callback URL registered there must exactly match
# DMS_ZITADEL_REDIRECT_URI below — request one from whoever administers the
# Nexotec Zitadel tenant if you don't have dev credentials yet.
DMS_ZITADEL_ISSUER=
DMS_ZITADEL_CLIENT_ID=
DMS_ZITADEL_CLIENT_SECRET=
DMS_ZITADEL_REDIRECT_URI=http://localhost:8000/v1/auth/oidc/callback

# Required, no built-in default — signs the transient OIDC login state/
# nonce/PKCE cookie only (app/main.py's SessionMiddleware), not the actual
# session. Generate your own locally, one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# `make up` generates one for you on first run, same as the two keys above.
DMS_SESSION_SECRET_KEY=

# Optional — where the OIDC callback sends the browser after a successful
# login. Empty (the default) means a same-origin relative redirect, correct
# for staging/prod (this app serves the built SPA itself). Local dev runs
# the Vite dev server on a different port, so it needs an absolute URL:
DMS_POST_LOGIN_REDIRECT_BASE_URL=http://localhost:5173

# Optional — observability (WP-2 PR-3). Unset means genuinely off, not a
# console fallback: no external service is required for local dev or tests.
# DMS_OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# DMS_OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 instance-id:api-key>
# DMS_SENTRY_DSN=
# DMS_ENVIRONMENT=development
