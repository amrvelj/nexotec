DMS_DATABASE_URL=postgresql+psycopg://dms:dms@localhost:5432/dms_platform

# Required, no built-in default or fallback (app fails to start without it).
# Generate your own locally, one per environment — never reuse the same key
# across dev/staging/prod, and never commit a real value here:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DMS_TAX_ID_ENCRYPTION_KEY=

# Required, no built-in default (ADR-007, WP-2 PR-1) — RS256, not the old
# shared HS256 secret. Generate your own locally, one per environment:
#   python -c "
#   from cryptography.hazmat.primitives import serialization
#   from cryptography.hazmat.primitives.asymmetric import rsa
#   key = rsa.generate_private_key(public_exponent=65537, key_size=2048)
#   print(key.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()).decode())"
# A real .env file (not this .example) can hold the PEM's actual newlines
# directly. `make up` generates one for you on first run — see the README's
# "Running the whole stack" section.
DMS_JWT_PRIVATE_KEY=

# KAN-196 (D-A-07): Nexotec owns authentication — password + MFA, no external
# identity provider. The demo manager's password for scripts/seed_staging_demo.py
# (12+ characters; leave empty to skip the seed).
DMS_SEED_DEMO_PASSWORD=
# Platform mail (invitations, resets — FR-AU-15, D-A-28): "logging" writes the
# message to the log, "smtp" sends it through the Nexotec-owned mailbox below.
# "logging" is refused unless DMS_ENVIRONMENT is development (KAN-397, ADR-099).
DMS_PLATFORM_MAIL_SENDER=logging
DMS_PLATFORM_MAIL_FROM=no-reply@nexotec.example
DMS_PLATFORM_MAIL_SMTP_HOST=
DMS_PLATFORM_MAIL_SMTP_PORT=587
DMS_PLATFORM_MAIL_SMTP_USERNAME=
DMS_PLATFORM_MAIL_SMTP_PASSWORD=
# Where the e-mails' links point and what passkeys are bound to: the SPA origin.
DMS_APP_BASE_URL=http://localhost:5173
DMS_WEBAUTHN_RP_ID=localhost
DMS_WEBAUTHN_ORIGIN=http://localhost:5173

# Optional — observability (WP-2 PR-3). Unset means genuinely off, not a
# console fallback: no external service is required for local dev or tests.
# DMS_OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
# DMS_OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 instance-id:api-key>
# DMS_SENTRY_DSN=
# DMS_ENVIRONMENT=development
