{
  "name": "@nexotec/frontend-workspace",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@nexotec/dms-web",
    "build": "npm run build --workspace=@nexotec/dms-web",
    "lint": "npm run lint --workspaces --if-present",
    "preview": "npm run preview --workspace=@nexotec/dms-web"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "*"
    }
  }
}
